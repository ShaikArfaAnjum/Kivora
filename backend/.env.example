KIVORA_ENV=development
SECRET_KEY=your_secure_jwt_secret_key_here
DATABASE_URL=sqlite:///./kivora.db
KIVORA_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
GEMINI_API_KEY=your_gemini_api_key_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=replace_with_your_app_password
SMTP_FROM_EMAIL=your_email@example.com

# Demo Accounts Deployment Passwords (Optional: overrides default evaluation password)
# DEMO_DEFAULT_PASSWORD=your_demo_password_here
# ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# OAuth 2.0 / OpenID Connect (Google & GitHub)
# Google OAuth 2.0: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Gnani AI Voice Integration (Prisma STT & Timbre TTS)
# Sign up / obtain key at https://api.vachana.ai (starts with vach_...)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Shivani
